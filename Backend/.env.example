# ─── Base ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/electro

# URL publique du site (front) — sert aux liens d'emails et aux retours de paiement
CLIENT_URL=http://localhost:5173
# Origines autorisées en CORS (virgules). Par défaut = CLIENT_URL
CORS_ORIGINS=http://localhost:5173
# URL publique de l'API, utilisée pour le webhook Chargily.
# Laisser vide si le front sert l'API via un proxy (/api) — c'est le cas avec Vercel.
API_PUBLIC_URL=

# ─── Sécurité ────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# lax : front et API sur le même domaine (proxy). none : domaines différents.
COOKIE_SAMESITE=lax

# Premier compte admin (créé automatiquement au démarrage s'il n'y a aucun admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Boutique ────────────────────────────────────────────
STORE_NAME=Electro
SHIPPING_FEE=600
# Livraison gratuite à partir de ce montant (0 = désactivé)
FREE_SHIPPING_THRESHOLD=0

# ─── Images (Cloudinary) — obligatoire en production ─────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=Electro

# ─── Paiement en ligne (Chargily Pay v2 : CIB / Edahabia) ─
# Laisser vide pour désactiver le paiement en ligne
CHARGILY_SECRET_KEY=
# test | live
CHARGILY_MODE=test
ONLINE_ORDER_TTL_MINUTES=60

# ─── Emails (SMTP : Brevo, Gmail, Mailjet…) ──────────────
# Sans SMTP_HOST, les emails sont seulement affichés dans les logs
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Electro <no-reply@votre-domaine.dz>
# Destinataire des alertes de nouvelles commandes (défaut : ADMIN_EMAIL)
ADMIN_NOTIFY_EMAIL=
